# ==============================================================================
# INTENTGUARD ENTERPRISE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE: Never prefix backend secrets with VITE_.
# All LLM API keys and signing secrets must remain strictly on the backend.

# Server Environment (development, sandbox, production)
ENVIRONMENT=sandbox
DEBUG=false

# Persistence Configuration
# SQLite Default (zero external dependency for local development):
DATABASE_URL=sqlite:///./intentguard.db
# PostgreSQL (Production / Docker Compose):
# DATABASE_URL=postgresql://intentguard:intentguard_secure_pw@localhost:5432/intentguard_db

# Cryptographic Signing & Session Secret (Must be >= 32 characters in production)
SECRET_KEY=intentguard-enterprise-dev-secret-key-32bytesmin!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Intent Extraction Provider (Server-side ONLY)
# If left empty, IntentGuard automatically uses its built-in offline deterministic rule engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Operational Policy Guardrails
DEFAULT_CONTRACT_TTL_MINUTES=120
ENFORCE_SINGLE_PURCHASE=true
MAX_PRICE_TOLERANCE_PCT=0.10

# Sandboxed Payment Execution (Never connect real money rails in sandbox mode)
SANDBOX_PAYMENT_ENABLED=true
SIMULATE_GATEWAY_LATENCY_MS=150
